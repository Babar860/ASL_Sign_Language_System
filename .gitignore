# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments and local dependency folders
.venv/
venv/
env/
ENV/
.env
.env.*

# IDE and OS noise
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Logs and runtime output
logs/*
!logs/.gitkeep
*.log
server.err.log
server.log

# Model checkpoints and ML artifacts
models/*
!models/.gitkeep
*.pth
*.pt
*.onnx
*.ckpt

# Dataset archives and large local data
archive/*.csv
archive/sign_mnist_train/
archive/sign_mnist_test/
*.zip
*.tar
*.tar.gz
*.7z

# Generated local avatar/image assets
assets/signs/*
!assets/signs/.gitkeep

# Build and packaging artifacts
build/
dist/
*.egg-info/
pip-wheel-metadata/
